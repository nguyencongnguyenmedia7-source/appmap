# ==============================================================================
# CITYVERSE - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local to configure your local development environment.
# Never commit real secret keys or service role keys to source control!

# ------------------------------------------------------------------------------
# 1. Mapbox Configuration
# ------------------------------------------------------------------------------
# Get your Mapbox Public Access Token from: https://account.mapbox.com/access-tokens/
# Must start with "pk." (Public key only. Never use Secret "sk." keys in mobile code!)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGVrZXkxMjM0NTY3ODkwYWJjZGVmIn0.example

# Mapbox Style URL (3D Standard or custom 3D dark/light style)
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/standard

# ------------------------------------------------------------------------------
# 2. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Get your project URL and anon key from: https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://fuwimehbldqvaookauvj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4r75VX_rR_N5S5c1cZhKLw_ypp8XsVb

# ------------------------------------------------------------------------------
# 3. Application Runtime Mode
# ------------------------------------------------------------------------------
# 'development' allows running with curated real Vietnamese POI mock cache
# when Supabase or Mapbox tokens are missing, without crashing or faking random coords.
# 'production' strictly requires valid tokens and database connectivity.
EXPO_PUBLIC_APP_ENV=development

# Enable client-side debug telemetry and map bounding box stats
EXPO_PUBLIC_ENABLE_MAP_TELEMETRY=true
